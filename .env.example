# ---------------------------------------------------------------------------
# Example configuration. NO real secrets belong in this repository.
#
# ASP.NET Core reads environment variables directly ("__" = nested section).
# Set them in your shell, e.g. PowerShell:  $env:ConnectionStrings__Default = "..."
# or (recommended for local development) use .NET user-secrets for the API:
#   dotnet user-secrets set "ConnectionStrings:Default" "<value>" --project StreamingAutomation.API
# ---------------------------------------------------------------------------

# --- API (StreamingAutomation.API) -----------------------------------------
ConnectionStrings__Default=Host=localhost;Port=5432;Database=streaming_automation;Username=postgres;Password=CHANGE_ME
Database__ApplyMigrationsOnStartup=true
Cors__AllowedOrigins__0=http://localhost:5173

MediaClient__BaseUrl=http://localhost:5200
MediaClient__AttemptTimeoutSeconds=5
MediaClient__TotalTimeoutSeconds=30
MediaClient__MaxRetryAttempts=3
MediaClient__RetryBaseDelayMs=200
MediaClient__MaxConnections=1000

Playback__MaxSessionsPerRun=1000
Playback__MaxGlobalConcurrency=1000
Playback__MaxPlaybackSpeed=100
Playback__FlushIntervalMs=1000
Playback__BroadcastIntervalMs=1000
Playback__StallTimeoutSeconds=45
Playback__WatchdogIntervalSeconds=5

# --- Test Media Server (StreamingAutomation.MediaServer) -------------------
MediaServer__SegmentDurationSeconds=2
MediaServer__BitrateKbps=128
MediaServer__BaseLatencyMs=15
MediaServer__LatencyJitterMs=35
MediaServer__TransientErrorRate=0.01

# --- Web dashboard (.env.local in the streaming-app repository) -------------------------------
# Leave empty in development: the Vite dev server proxies /api and /hubs.
VITE_API_BASE_URL=
VITE_API_PROXY_TARGET=http://localhost:5126
