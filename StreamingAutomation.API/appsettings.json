{
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=streaming_automation;Username=postgres;Password="
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http.HttpClient": "Warning",
        "Polly": "Fatal"
      }
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173" ]
  },
  "Database": {
    "ApplyMigrationsOnStartup": true
  },
  "MediaClient": {
    "BaseUrl": "http://localhost:5200",
    "AttemptTimeoutSeconds": 5,
    "TotalTimeoutSeconds": 30,
    "MaxRetryAttempts": 3,
    "RetryBaseDelayMs": 200,
    "MaxConnections": 1000
  },
  "Playback": {
    "MaxSessionsPerRun": 1000,
    "MaxGlobalConcurrency": 1000,
    "MaxPlaybackSpeed": 100,
    "FlushIntervalMs": 1000,
    "StallTimeoutSeconds": 45,
    "WatchdogIntervalSeconds": 5
  }
}
